# Secrets and local config
.env
.env.*
!.env.example
.claude/settings.local.json
# Deployment-specific IdP group IDs (config/oidc_roles.example.yaml is the committed template).
config/oidc_roles.yaml

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node
node_modules/
dist/
frontend/playwright-report/
frontend/test-results/

# Runtime data (local DB, uploaded files, rendered outputs)
*.db
*.db-shm
*.db-wal
storage/

# Confidential GTM source material (brand guides, tier docs, real examples).
# Structured, reviewed catalog files ARE committed; raw sources are not by default.
# Delete these two lines if the material is safe to commit.
gtm_catalog/sources/*
!gtm_catalog/sources/README.md

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
