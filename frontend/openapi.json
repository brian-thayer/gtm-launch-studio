{
  "components": {
    "schemas": {
      "ActivityEvent": {
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "actor_display": {
            "title": "Actor Display",
            "type": "string"
          },
          "actor_user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor User Id"
          },
          "after_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "After Hash"
          },
          "before_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Before Hash"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "entity_id": {
            "title": "Entity Id",
            "type": "string"
          },
          "entity_type": {
            "title": "Entity Type",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "user_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agent"
          }
        },
        "required": [
          "id",
          "occurred_at",
          "actor_user_id",
          "actor_display",
          "action",
          "entity_type",
          "entity_id",
          "request_id",
          "ip",
          "user_agent",
          "details",
          "before_hash",
          "after_hash"
        ],
        "title": "ActivityEvent",
        "type": "object"
      },
      "ActivityPage": {
        "description": "Newest first. Pass ``next_cursor`` back as ``cursor`` for the following page; None means the end.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ActivityEvent"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "ActivityPage",
        "type": "object"
      },
      "AuthOptions": {
        "description": "What the login page shows. ``dev_users`` is filled only for the dev provider.",
        "properties": {
          "dev_users": {
            "items": {
              "$ref": "#/components/schemas/DevUserOption"
            },
            "title": "Dev Users",
            "type": "array"
          },
          "provider": {
            "enum": [
              "dev",
              "oidc"
            ],
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider"
        ],
        "title": "AuthOptions",
        "type": "object"
      },
      "DevLoginRequest": {
        "properties": {
          "user_id": {
            "maxLength": 36,
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "title": "DevLoginRequest",
        "type": "object"
      },
      "DevUserOption": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "id",
          "display_name",
          "roles"
        ],
        "title": "DevUserOption",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "db": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Db",
            "type": "string"
          },
          "env": {
            "enum": [
              "dev",
              "test",
              "production"
            ],
            "title": "Env",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "env",
          "db"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Me": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "title": "Permissions",
            "type": "array"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "roles",
          "permissions"
        ],
        "title": "Me",
        "type": "object"
      },
      "Permission": {
        "enum": [
          "solution:read",
          "context:write",
          "import:run",
          "asset:generate",
          "asset:review",
          "audit:read",
          "catalog:read",
          "catalog:admin",
          "user:admin"
        ],
        "title": "Permission",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "GTM Launch Studio",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/activity": {
      "get": {
        "description": "Every audit event, newest first. Needs the `audit:read` permission.",
        "operationId": "activity_list_activity",
        "parameters": [
          {
            "description": "Only this user's events.",
            "in": "query",
            "name": "actor_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 36,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only this user's events.",
              "title": "Actor Id"
            }
          },
          {
            "description": "`next_cursor` of the previous page. Opaque.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 300,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`next_cursor` of the previous page. Opaque.",
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "entity_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 50,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Entity Type"
            }
          },
          {
            "in": "query",
            "name": "entity_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Entity Id"
            }
          },
          {
            "description": "Match actions that start with this, e.g. `asset.`.",
            "in": "query",
            "name": "action_prefix",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Match actions that start with this, e.g. `asset.`.",
              "title": "Action Prefix"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Activity",
        "tags": [
          "activity"
        ]
      }
    },
    "/api/activity/me": {
      "get": {
        "description": "The signed-in user's own audit events, newest first.",
        "operationId": "activity_list_my_activity",
        "parameters": [
          {
            "description": "`next_cursor` of the previous page. Opaque.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 300,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`next_cursor` of the previous page. Opaque.",
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "entity_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 50,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Entity Type"
            }
          },
          {
            "in": "query",
            "name": "entity_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Entity Id"
            }
          },
          {
            "description": "Match actions that start with this, e.g. `asset.`.",
            "in": "query",
            "name": "action_prefix",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Match actions that start with this, e.g. `asset.`.",
              "title": "Action Prefix"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List My Activity",
        "tags": [
          "activity"
        ]
      }
    },
    "/api/auth/dev/login": {
      "post": {
        "description": "Sign in as a seeded user. 404 for an unknown or inactive user, and whenever the provider isn't dev.\nBoth outcomes are audited (`auth.login`, `auth.login_denied`).",
        "operationId": "auth_dev_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Dev Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "auth_logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "auth_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/oidc/callback": {
      "get": {
        "description": "Where the identity provider sends the browser back. On success: start the session, audit\n`auth.login` (with the roles the groups mapped to) and redirect to the frontend page asked for. A\nrefused person is audited (`auth.login_denied`, with a reason); any failure redirects to\n`/login?error=denied|failed` and signs nobody in.",
        "operationId": "auth_oidc_callback",
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "404": {
            "description": "OIDC is not the configured provider"
          }
        },
        "summary": "Oidc Callback",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/oidc/login": {
      "get": {
        "description": "Start the OIDC sign-in: redirect the browser to the identity provider. Open by nature (it is how\na session starts), but it changes nothing: ``state`` and the PKCE verifier go in the caller's own\ncookie. ``next`` is checked now and again at the callback.",
        "operationId": "auth_oidc_login",
        "parameters": [
          {
            "description": "Same-site path to return to; else `/`",
            "in": "query",
            "name": "next",
            "required": false,
            "schema": {
              "default": "/",
              "description": "Same-site path to return to; else `/`",
              "title": "Next",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "404": {
            "description": "OIDC is not the configured provider"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "description": "IdP unreachable"
          }
        },
        "summary": "Oidc Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/options": {
      "get": {
        "description": "Unauthenticated: what the login page needs.",
        "operationId": "auth_options",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthOptions"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Options",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    }
  }
}
